# Pulse Environment Variables

# --- Go API & Worker Configuration ---
PORT=8080
PULSE_ENV=development
WORKER_CONCURRENCY=20
CHECK_INTERVAL_SEC=10
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Store configuration: "memory" for local dev without GCP credentials, "firestore" for production/emulator
STORE_TYPE=memory
FIRESTORE_PROJECT_ID=pulse-dev
GOOGLE_APPLICATION_CREDENTIALS=

# Alerting Webhooks / Tokens (for testing & worker defaults)
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Next.js Frontend Configuration (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pulse-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pulse-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=pulse-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
